  "contrast_pairs": [
    {
      "description": "CRITICAL: QUERY vs PURCHASE semantic distinction examples",
      "pairs": [
        {
          "text": "how many sms do i have left",
          "correct_intent": "sms_usage_query",
          "common_wrong_intent": "subscribe_offer",
          "why_correct": "User wants to VIEW existing status, not buy anything"
        },
        {
          "text": "i want to buy an sms package",
          "correct_intent": "subscribe_offer",
          "common_wrong_intent": "sms_usage_query",
          "why_correct": "User explicitly wants to PURCHASE"
        },
        {
          "text": "i ran out of sms, i want to buy more",
          "correct_intents": ["sms_usage_query", "subscribe_offer"],
          "why_correct": "User states running out (QUERY) then buying (PURCHASE) — TWO intents"
        },
        {
          "text": "show me available sms packages",
          "correct_intent": "view_offers",
          "why_correct": "User wants to BROWSE offers, not purchase yet"
        },
        {
          "text": "check my remaining data",
          "correct_intent": "data_usage_query",
          "common_wrong_intent": "subscribe_offer",
          "why_correct": "User wants to VIEW data status, not subscribe"
        },
        {
          "text": "i used all my data, i need a new plan",
          "correct_intents": ["data_usage_query", "subscribe_offer"],
          "why_correct": "User states usage exhausted THEN wants to purchase — TWO intents"
        },
        {
          "text": "how much talk time do i have",
          "correct_intent": "voice_usage_query",
          "common_wrong_intent": "subscribe_offer",
          "why_correct": "User wants to VIEW voice status, not subscribe"
        },
        {
          "text": "i need more minutes, buy a pack",
          "correct_intents": ["voice_usage_query", "subscribe_offer"],
          "why_correct": "User acknowledges need THEN wants to purchase — TWO intents"
        }
      ]
    }
  ]
